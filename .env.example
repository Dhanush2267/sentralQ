# ==============================================================================
# SentralQ Environment Variables Template
# ==============================================================================

# Backend General Settings
APP_NAME="SentralQ Surveillance Intelligence Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production

# Backend Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Fallback to sqlite if database server is not configured/running
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentralq"

# Frontend Configuration
FRONTEND_URL="http://localhost:5173"

# Security & Token Settings
JWT_SECRET="super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Grok / Llama Search Configuration
GROK_API_KEY=""
GROK_API_BASE="https://api.groq.com/openai/v1"
GROK_MODEL_NAME="llama-3.3-70b-versatile"
